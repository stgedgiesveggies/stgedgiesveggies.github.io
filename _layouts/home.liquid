        </div>
        <div class="hp-veggie-price">$6.00</div>
        <div class="hp-veggie-arrow">→</div>
      </div>

      <div class="hp-veggie-row">
        <div class="hp-veggie-thumb" style="background:linear-gradient(135deg,#d04a4a,#f8b890)">🥕</div>
        <div class="hp-veggie-info">
          <div class="hp-veggie-name">Baby Carrots</div>
          <div class="hp-veggie-note">Sweet, tops still on</div>
        </div>
        <div class="hp-veggie-price">$4.50</div>
        <div class="hp-veggie-arrow">→</div>
      </div>

      <div class="hp-veggie-row">
        <div class="hp-veggie-thumb" style="background:linear-gradient(135deg,#7e5fa8,#c0a8d8)">🟣</div>
        <div class="hp-veggie-info">
          <div class="hp-veggie-name">Purple Top Turnips</div>
