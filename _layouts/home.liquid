<!DOCTYPE html>
<html lang="en">
{% include head.html %}

<body>

  {% assign featured_veggie = site.veggies | where: "featured", true | first %}

  <!-- NAV -->
  <nav class="hp-nav">
    <a href="{{ '/' | relative_url }}" class="hp-wordmark">
      <span class="hp-wordmark-edgies">Edgie's</span>
      <span class="hp-wordmark-veggies">Veggies</span>
    </a>
    <a href="{{ '/veggies/' | relative_url }}" class="hp-nav-link">All veggies →</a>
  </nav>

  <!-- 1. FEATURED VEGGIE · full-bleed hero -->
  <section class="hp-hero">
    <div class="hp-hero-img" aria-hidden="true">
      {% if featured_veggie and featured_veggie.cover_image %}
      <img src="{{ featured_veggie.cover_image | relative_url }}" alt="" fetchpriority="high">
      {% else %}
      <picture>
        <source type="image/webp"
          srcset="{{ '/assets/images/home-slides/radishes-750.webp' | relative_url }} 750w,
                  {{ '/assets/images/home-slides/radishes-1500.webp' | relative_url }} 1500w"
          sizes="100vw">
        <img src="{{ '/assets/images/home-slides/radishes.jpeg' | relative_url }}"
          alt="" fetchpriority="high">
      </picture>
      {% endif %}
    </div>

    <div class="hp-hero-badge">
      <span>★</span> This week
    </div>

    <div class="hp-hero-content">
      <div class="hp-hero-eyebrow">Veggie of the week</div>
      {% if featured_veggie %}
      <h1 class="hp-hero-title"><span>{{ featured_veggie.title | replace: " ", "<br>" }}</span></h1>
      <p class="hp-hero-blurb">{{ featured_veggie.hero_blurb }}</p>
      <div class="hp-hero-ctas">
        <a href="{{ featured_veggie.url | relative_url }}" class="hp-btn hp-btn-primary">
          <span>See recipes</span> <span>→</span>
        </a>
        <a href="#all-veggies" class="hp-btn hp-btn-outline">
          <span>Also at the stall</span> <span>↓</span>
        </a>
      </div>
      {% else %}
      <h1 class="hp-hero-title"><span>Watermelon<br>Radish</span></h1>
      <p class="hp-hero-blurb">
        Plain on the outside, fireworks on the inside. Slice thin to see the rings — mild, crisp, just a whisper of pepper.
      </p>
      <div class="hp-hero-ctas">
        <a href="{{ '/updates/' | relative_url }}" class="hp-btn hp-btn-primary">
          <span>See recipes</span> <span>→</span>
        </a>
        <a href="#all-veggies" class="hp-btn hp-btn-outline">
          <span>Also at the stall</span> <span>↓</span>
        </a>
      </div>
      {% endif %}
    </div>
  </section>

  <!-- 2. STALL INFO -->
  <section class="hp-stall-bar">
    <div class="hp-stall-inner">
      <div class="hp-stall-row">
        <div>
          <div class="hp-stall-label">Find us</div>
          <div class="hp-stall-where">St. Paul Farmers' Market</div>
          <div class="hp-stall-when">Saturdays · <span class="hp-hours-inline">8 am – 1 pm</span> · stall #14, east end</div>
        </div>
      </div>
      <div class="hp-stall-ctas">
        <button onclick="getDirections()" class="hp-btn hp-btn-stall-primary">
          <span>📍</span> <span>Get directions</span>
        </button>
        <button onclick="downloadIcs()" class="hp-btn hp-btn-stall-outline">
          <span>📅</span> <span>Add to calendar</span>
        </button>
      </div>
    </div>
  </section>

  <!-- 3. EDITORIAL · From the field -->
  {% assign latest_post = site.posts.first %}
  {% if latest_post %}
  <section class="hp-editorial">
    <div class="hp-ed-eyebrow">From the field · {{ latest_post.date | date: "%B %-d" }}</div>
    <h2 class="hp-ed-title">{{ latest_post.title }}</h2>
    <div class="hp-ed-body">
      {{ latest_post.content }}
    </div>
    <div class="hp-signoff">
      <div class="hp-signoff-name">Edgie</div>
      <div class="hp-signoff-role">Grower · St. Paul, MN</div>
    </div>
  </section>
  {% endif %}

  <!-- 4. ALSO AT THE STALL · index -->
  {% assign in_season_veggies = site.veggies | where: "in_season", true | sort: "display_order" %}
  <section id="all-veggies" class="hp-index">
    <div class="hp-index-inner">
      <div class="hp-index-head">
        <div class="hp-index-head-left">
          <div class="hp-index-eyebrow">[ also at the stall ]</div>
          <div class="hp-index-title">This Saturday</div>
        </div>
        {% if in_season_veggies.size > 0 %}
        <div class="hp-index-count">{{ in_season_veggies.size }} in season</div>
        {% endif %}
      </div>

      {% for veggie in in_season_veggies %}
      <a href="{{ veggie.url | relative_url }}" class="hp-veggie-row">
        <div class="hp-veggie-thumb" {% if veggie.thumb_gradient and veggie.thumb_image == nil %}style="background:{{ veggie.thumb_gradient }}"{% endif %}>
          {% if veggie.thumb_image %}<img src="{{ veggie.thumb_image | relative_url }}" alt="{{ veggie.title }}">{% endif %}
        </div>
        <div class="hp-veggie-info">
          <div class="hp-veggie-name">{{ veggie.title }}</div>
          {% if veggie.note %}<div class="hp-veggie-note">{{ veggie.note }}</div>{% endif %}
        </div>
        {% if veggie.price %}<div class="hp-veggie-price">{{ veggie.price }}</div>{% endif %}
        <div class="hp-veggie-arrow">→</div>
      </a>
      {% endfor %}

      <div class="hp-index-footer">
        <a href="{{ '/veggies/' | relative_url }}">↓ See all veggies</a>
      </div>
    </div>
  </section>

  <!-- 5. NEWSLETTER -->
  <section class="hp-newsletter">
    <div class="hp-newsletter-inner">
      <h2 class="hp-newsletter-heading">Know what's coming before you arrive.</h2>
      <p class="hp-newsletter-subtext">Get harvest updates every Friday — what's ready, what's almost gone, and what's just coming in.</p>
      <form class="js-cm-form hp-newsletter-form"
        action="https://www.createsend.com/t/subscribeerror?description="
        method="post"
        data-id="2BE4EF332AA2E32596E38B640E9056198AB1CE755310223F51B9B7A1A84ECCF0D5273ABBAB8D761069F57EC9F57688E765894B26C821D8708B348E851258F3F4">
        <input type="email"
          class="js-cm-email-input hp-newsletter-input"
          name="cm-ydykkhy-ydykkhy"
          placeholder="your@email.com"
          autocomplete="email"
          required>
        <button type="submit" class="hp-newsletter-btn">Get updates</button>
      </form>
      <script async src="https://js.createsend1.com/javascript/copypastesubscribeformlogic.js"></script>
    </div>
  </section>

  <!-- 6. FOOTER -->
  <footer class="hp-footer">
    <div class="hp-footer-wm">EDGIE'S VEGGIES</div>
    <div class="hp-footer-meta">St. Paul Farmers' Market · Saturdays · edgiesveggies.com</div>
  </footer>

  <script>
    function getDirections() {
      const isApple = /iPhone|iPad|iPod|Macintosh/.test(navigator.userAgent);
      const query = 'St+Paul+Farmers+Market,+290+5th+St+E,+Saint+Paul,+MN+55101';
      const url = isApple
        ? 'https://maps.apple.com/?q=' + query
        : 'https://maps.google.com/?q=' + query;
      window.open(url, '_blank', 'noopener');
    }

    function downloadIcs() {
      const now = new Date();
      const day = now.getDay();
      const daysToSat = (6 - day + 7) % 7 || 7;
      const sat = new Date(now);
      sat.setDate(now.getDate() + daysToSat);
      const yyyy = sat.getFullYear();
      const mm = String(sat.getMonth() + 1).padStart(2, '0');
      const dd = String(sat.getDate()).padStart(2, '0');
      const dtStart = `${yyyy}${mm}${dd}T080000`;
      const dtEnd   = `${yyyy}${mm}${dd}T130000`;
      const ics = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//Edgies Veggies//EN',
        'BEGIN:VEVENT',
        `UID:edgies-${yyyy}${mm}${dd}@edgiesveggies.com`,
        `DTSTAMP:${dtStart}`,
        `DTSTART:${dtStart}`,
        `DTEND:${dtEnd}`,
        "SUMMARY:Edgie's Veggies — Farmers' Market",
        "LOCATION:St. Paul Farmers' Market, 290 5th St E, Saint Paul, MN 55101",
        "DESCRIPTION:Stop by for this week's harvest. Stall #14, east end.",
        'RRULE:FREQ=WEEKLY;BYDAY=SA',
        'END:VEVENT',
        'END:VCALENDAR'
      ].join('\r\n');
      const blob = new Blob([ics], { type: 'text/calendar' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'edgies-veggies-market.ics';
      a.click();
      URL.revokeObjectURL(url);
    }
  </script>

</body>
</html>
