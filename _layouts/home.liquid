<!DOCTYPE html>
<html lang="en">
{% include head.html %}

<body>

  <!-- NAV -->
  <nav class="hp-nav">
    <a href="{{ '/' | relative_url }}" class="hp-wordmark">
      <span class="hp-wordmark-edgies">Edgie's</span>
      <span class="hp-wordmark-veggies">Veggies</span>
    </a>
    <a href="#all-veggies" class="hp-nav-link">All veggies →</a>
  </nav>

  <!-- 1. FEATURED VEGGIE · full-bleed hero -->
  <section class="hp-hero">
    <div class="hp-hero-img" aria-hidden="true">
      <picture>
        <source type="image/webp"
          srcset="{{ '/assets/images/home-slides/radishes-750.webp' | relative_url }} 750w,
                  {{ '/assets/images/home-slides/radishes-1500.webp' | relative_url }} 1500w"
          sizes="100vw">
        <img src="{{ '/assets/images/home-slides/radishes.jpeg' | relative_url }}"
          alt="" fetchpriority="high">
      </picture>
    </div>

    <div class="hp-hero-badge">
      <span>★</span> This week
    </div>

    <div class="hp-hero-content">
      <div class="hp-hero-eyebrow">Veggie of the week</div>
      <h1 class="hp-hero-title">Watermelon<br>Radish</h1>
      <p class="hp-hero-blurb">
        Plain on the outside, fireworks on the inside. Slice thin to see the rings — mild, crisp, just a whisper of pepper.
      </p>
      <div class="hp-hero-ctas">
        <a href="{{ '/updates/' | relative_url }}" class="hp-btn hp-btn-primary">
          <span>See recipes</span> <span>→</span>
        </a>
        <a href="#all-veggies" class="hp-btn hp-btn-outline">
          <span>See all veggies</span> <span>↓</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 2. STALL INFO -->
  <section class="hp-stall-bar">
    <div class="hp-stall-inner">
      <div class="hp-stall-row">
        <div>
          <div class="hp-stall-label">Find us</div>
          <div class="hp-stall-where">St. Paul Farmers' Market</div>
          <div class="hp-stall-when">Saturdays · stall #14, east end</div>
        </div>
        <div class="hp-hours-pill">8a–1p</div>
      </div>
      <div class="hp-stall-ctas">
        <a href="https://maps.google.com/?q=St+Paul+Farmers+Market,+290+5th+St+E,+Saint+Paul,+MN+55101"
          target="_blank" rel="noopener" class="hp-btn hp-btn-stall-primary">
          <span>📍</span> <span>Get directions</span>
        </a>
        <button onclick="downloadIcs()" class="hp-btn hp-btn-stall-outline">
          <span>📅</span> <span>Add to calendar</span>
        </button>
      </div>
    </div>
  </section>

  <!-- 3. EDITORIAL · From the field -->
  {% assign latest_post = site.posts.first %}
  {% if latest_post %}
  <section class="hp-editorial">
    <div class="hp-ed-eyebrow">From the field · {{ latest_post.date | date: "%B %-d" }}</div>
    <h2 class="hp-ed-title">{{ latest_post.title }}</h2>
    <div class="hp-ed-body">
      {{ latest_post.content }}
    </div>
    <div class="hp-signoff">
      <div class="hp-signoff-name">Edgie</div>
      <div class="hp-signoff-role">Grower · St. Paul, MN</div>
    </div>
  </section>
  {% endif %}

  <!-- 4. ALSO AT THE STALL · index -->
  <section id="all-veggies" class="hp-index">
    <div class="hp-index-inner">
      <div class="hp-index-head">
        <div class="hp-index-head-left">
          <div class="hp-index-eyebrow">[ also at the stall ]</div>
          <div class="hp-index-title">This Saturday</div>
        </div>
        <div class="hp-index-count">12 in season</div>
      </div>

      <a href="{{ '/updates/' | relative_url }}" class="hp-veggie-row">
        <div class="hp-veggie-thumb" style="background:linear-gradient(135deg,#cf0089,#f5d0e0)">
          <svg viewBox="0 0 40 40" style="width:100%;height:100%;display:block" aria-hidden="true"><circle cx="20" cy="24" r="13" fill="#fff" opacity="0.3"/><circle cx="20" cy="24" r="7" fill="#fff" opacity="0.5"/><circle cx="20" cy="24" r="3" fill="#fff" opacity="0.7"/></svg>
        </div>
        <div class="hp-veggie-info">
          <div class="hp-veggie-name">Watermelon Radish</div>
          <div class="hp-veggie-note">Crisp, mild, peppery rings</div>
        </div>
        <div class="hp-veggie-price">$3.50</div>
        <div class="hp-veggie-arrow">→</div>
      </a>

      <div class="hp-veggie-row">
        <div class="hp-veggie-thumb" style="background:linear-gradient(135deg,#7ab550,#c9e0a8)">🥬</div>
        <div class="hp-veggie-info">
          <div class="hp-veggie-name">Butterhead Lettuce</div>
          <div class="hp-veggie-note">Soft heads, just-picked</div>
        </div>
        <div class="hp-veggie-price">$4.00</div>
        <div class="hp-veggie-arrow">→</div>
      </div>

      <div class="hp-veggie-row">
        <div class="hp-veggie-thumb" style="background:linear-gradient(135deg,#5ca85a,#a8d0a0)">🌱</div>
        <div class="hp-veggie-info">
          <div class="hp-veggie-name">Sugar Snap Peas</div>
          <div class="hp-veggie-note">First of the season — sweet, crunchy</div>
        </div>
        <div class="hp-veggie-price">$5.00</div>
        <div class="hp-veggie-arrow">→</div>
      </div>

      <div class="hp-veggie-row">
        <div class="hp-veggie-thumb" style="background:linear-gradient(135deg,#d04a4a,#f0c098,#7ab550)">🌈</div>
        <div class="hp-veggie-info">
          <div class="hp-veggie-name">Rainbow Chard</div>
          <div class="hp-veggie-note">Last of the spring crop</div>
        </div>
        <div class="hp-veggie-price">$3.00</div>
        <div class="hp-veggie-arrow">→</div>
      </div>

      <div class="hp-veggie-row">
        <div class="hp-veggie-thumb" style="background:linear-gradient(135deg,#9bc060,#d8e8b8)">🥒</div>
        <div class="hp-veggie-info">
          <div class="hp-veggie-name">Asparagus</div>
